# .env.example — safe reference template. Copy to .env and fill in real values.
# The .env file is NEVER copied into the container image (enforced via .dockerignore).
# Inject at runtime: podman run --env-file .env  /  docker run --env-file .env

# ---------------------------------------------------------------------------
# Liberty application server
# ---------------------------------------------------------------------------

# TCP port Liberty listens on for plain HTTP traffic inside the container.
LIBERTY_HTTP_PORT=80

# TCP port Liberty listens on for HTTPS (TLS) traffic inside the container.
LIBERTY_HTTPS_PORT=9443

# TCP HTTP Host Port to access the container
HOST_HTTP_PORT=4011

# TCP HTTPS Host Port to access the container
HOST_HTTPS_PORT=4012

# Password for the PKCS12 keystore used by the HTTPS listener.
# In production, replace with a strong random value and mount the actual keystore.
LIBERTY_KEYSTORE_PASSWORD=changeit

# ---------------------------------------------------------------------------
# Application runtime
# ---------------------------------------------------------------------------

# Deployment tier: development | staging | production
# Read by the app via MicroProfile Config (@ConfigProperty(name="APP_ENV")).
APP_ENV=development

# Base URL the frontend uses to call the backend REST API.
# In a same-origin deployment (Liberty serves both) this is just the origin.
# In a CDN/split deployment, set the full backend origin (e.g. https://api.example.com).
API_BASE_URL=http://localhost:4011

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Secret used to sign and verify JWTs (MicroProfile JWT).
# Minimum 32 random characters in production. Never commit a real value.
JWT_SECRET=replace-with-a-secure-random-string-min-32-chars

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Hostname or IP of the database server visible from inside the container.
# Use a service name when running in Compose / Kubernetes (e.g. "postgres").
DB_HOST=localhost

# Database server port.
DB_PORT=5432

# Name of the target database / schema.
DB_NAME=schema1

# Database user the application connects as.
DB_USER=appuser

# Password for DB_USER. Use a secrets manager in production.
DB_PASSWORD=replace-with-a-secure-db-password
